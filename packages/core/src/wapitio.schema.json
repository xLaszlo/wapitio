{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/xLaszlo/wapitio/main/packages/core/src/wapitio.schema.json",
  "title": "wapitio diagram",
  "description": "Diagram document rendered by wapitio (vue-flow + elkjs). Coordinates are computed automatically — never include x/y.",
  "type": "object",
  "required": ["version", "nodes"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. Always 1."
    },
    "title": {
      "type": "string",
      "description": "Optional diagram title."
    },
    "direction": {
      "type": "string",
      "enum": ["DOWN", "RIGHT", "UP", "LEFT"],
      "default": "DOWN",
      "description": "Overall flow direction for the layered layout."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/definitions/group" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique node identifier, referenced by edges."
        },
        "label": {
          "type": "string",
          "description": "Display text. Defaults to the id."
        },
        "type": {
          "type": "string",
          "enum": ["service", "database", "queue", "external", "person", "group"],
          "description": "Visual style hint. Unknown values fall back to the default style."
        },
        "group": {
          "type": "string",
          "description": "Id of a group defined in the top-level groups array."
        },
        "description": {
          "type": "string",
          "description": "Optional subtitle or tooltip text."
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "Id of the source node."
        },
        "to": {
          "type": "string",
          "description": "Id of the target node."
        },
        "label": {
          "type": "string",
          "description": "Optional edge label."
        },
        "dashed": {
          "type": "boolean",
          "description": "Render as a dashed line with an open arrow (e.g. optional dependency)."
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Group identifier referenced by node.group."
        },
        "label": {
          "type": "string",
          "description": "Display text for the group container."
        }
      }
    }
  }
}
